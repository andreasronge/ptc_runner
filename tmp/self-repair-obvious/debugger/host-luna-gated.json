      "accepts_data": ["normal", "private_inspection"],
      "transport": {
        "type": "stdio",
        "command": "node",
        "cwd": "/Users/andreasronge/projects/ptc_runner-codex-self-repair-obvious",
        "args": [
          "/Users/andreasronge/projects/ptc_runner-codex-self-repair-obvious/tmp/self-repair-obvious/debugger/repair_gate_server.mjs",
