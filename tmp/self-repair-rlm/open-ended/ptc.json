{
  "version": 1,
  "workflow": {
    "components": [{"library": "agent.main"}],
    "entry": "agent.main/run"
  },
  "missions": {
    "default": {
      "components": [{"library": "debug.nav"}],
      "providers": ["history", "debug.nav"]
    }
  },
  "input": {
    "value": {
      "task": "Analyze one failed PtcRunner run using only its immutable captured evidence. Explore whatever collections and relationships are useful. Explain the causal reason the run stopped, cite concrete evidence, and recommend the smallest useful next change. Distinguish observed facts from inference and do not assume the intended diagnosis from the task wording. Return exactly run_id, summary, evidence, and next_step; evidence is an array of strings. Use return only for the final report.",
      "agent": {
        "max_turns": 10,
        "max_observation_chars": 32768,
        "max_transcript_chars": 300000,
        "consolidate_at_turns_remaining": 3
      }
    }
  },
  "providers": {
    "workflow": [{"name": "agent_model"}],
    "mission": [
      {"name": "history", "config": {"expose": false}},
      {"name": "debug.nav"}
    ]
  },
  "contracts": {"result_schema": {"path": "report.schema.json"}},
  "limits": {
    "run_duration_ms": 300000,
    "workflow_timeout_ms": 300000,
    "evaluation_timeout_ms": 30000,
    "subordinate_evaluations": 16,
    "workflow_capability_calls": 16,
    "workflow_capability_calls_per_name": 16,
    "mission_capability_calls": 128,
    "mission_capability_calls_per_name": 128,
    "normal_event_count": 4096
  },
  "labels": {
    "name": "self-repair-open-ended-debugger",
    "tags": {"mode": "agent", "stage": "validating", "suite": "e2e"}
  }
}
