{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-analyst joined evaluation trial",
  "description": "One validated trial value joined by the trusted host to that run's identity. The workflow cannot invent its own effective bundle, provider snapshots, verified override, or result hash.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "const": "scored"},
        "subject": {"type": "string", "enum": ["baseline", "candidate"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 64},
        "candidate": {
          "type": "object",
          "properties": {
            "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "base_source_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "source_hash": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "required": ["component_id", "base_source_hash", "source_hash"]
        },
        "case": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128},
            "set": {
              "type": "string",
              "enum": ["motivating", "regression", "held-out", "negative-control"]
            },
            "case_hash": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "required": ["id", "set", "case_hash"]
        },
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "run_identity": {
          "type": "object",
          "properties": {
            "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "result_hash": {"type": "string", "minLength": 71, "maxLength": 71},
            "workflow_bundle_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "mission_bundle_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "provider_snapshot_hashes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "content_snapshot_hashes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "fixture_set_hash": {"type": "string", "maxLength": 128},
            "override_component_id": {"type": "string", "maxLength": 128},
            "override_base_source_hash": {"type": "string", "maxLength": 128},
            "override_source_hash": {"type": "string", "maxLength": 128}
          },
          "required": [
            "run_id",
            "result_hash",
            "workflow_bundle_hash",
            "mission_bundle_hash",
            "provider_snapshot_hashes",
            "content_snapshot_hashes"
          ]
        }
      },
      "required": [
        "status",
        "subject",
        "repetition",
        "candidate",
        "case",
        "passed",
        "detail",
        "run_identity"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "const": "subject-failure"},
        "subject": {"type": "string", "enum": ["baseline", "candidate"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 64},
        "candidate": {
          "type": "object",
          "properties": {
            "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "base_source_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "source_hash": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "required": ["component_id", "base_source_hash", "source_hash"]
        },
        "case": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128},
            "set": {
              "type": "string",
              "enum": ["motivating", "regression", "held-out", "negative-control"]
            },
            "case_hash": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "required": ["id", "set", "case_hash"]
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "turn-limit",
                "model-program-failed",
                "non-retryable-evaluation",
                "invalid-answer"
              ]
            }
          },
          "required": ["kind"]
        },
        "passed": {"type": "boolean", "const": false},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "run_identity": {
          "type": "object",
          "properties": {
            "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "result_hash": {"type": "string", "minLength": 71, "maxLength": 71},
            "workflow_bundle_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "mission_bundle_hash": {"type": "string", "minLength": 1, "maxLength": 128},
            "provider_snapshot_hashes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "content_snapshot_hashes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "fixture_set_hash": {"type": "string", "maxLength": 128},
            "override_component_id": {"type": "string", "maxLength": 128},
            "override_base_source_hash": {"type": "string", "maxLength": 128},
            "override_source_hash": {"type": "string", "maxLength": 128}
          },
          "required": [
            "run_id",
            "result_hash",
            "workflow_bundle_hash",
            "mission_bundle_hash",
            "provider_snapshot_hashes",
            "content_snapshot_hashes"
          ]
        }
      },
      "required": [
        "status",
        "subject",
        "repetition",
        "candidate",
        "case",
        "failure",
        "passed",
        "detail",
        "run_identity"
      ]
    }
  ]
}
