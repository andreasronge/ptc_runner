{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repo-analyst aggregate input",
  "description": "A bounded collection of joined trial records. Each record combines the trial's validated private result with identities copied by the trusted host from that same run's trace.",
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "set": {
                "type": "string",
                "enum": ["motivating", "regression", "held-out", "negative-control"]
              },
              "case_hash": {
                "type": "string",
                "minLength": 71,
                "maxLength": 71
              },
              "repetitions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {"type": "integer", "minimum": 1, "maximum": 64}
              }
            },
            "required": ["id", "set", "case_hash", "repetitions"]
          }
        }
      },
      "required": ["cases"]
    },
    "trials": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "enum": ["baseline", "candidate"]
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "candidate": {
            "type": "object",
            "properties": {
              "component_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "base_source_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "source_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": ["component_id", "base_source_hash", "source_hash"]
          },
          "case": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "set": {
                "type": "string",
                "enum": ["motivating", "regression", "held-out", "negative-control"]
              },
              "case_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": ["id", "set", "case_hash"]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "run_identity": {
            "type": "object",
            "properties": {
              "workflow_bundle_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "result_hash": {
                "type": "string",
                "minLength": 71,
                "maxLength": 71
              },
              "mission_bundle_hash": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "provider_snapshot_hashes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "content_snapshot_hashes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "fixture_set_hash": {
                "type": "string",
                "maxLength": 128
              },
              "override_component_id": {
                "type": "string",
                "maxLength": 128
              },
              "override_base_source_hash": {
                "type": "string",
                "maxLength": 128
              },
              "override_source_hash": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "run_id",
              "result_hash",
              "workflow_bundle_hash",
              "mission_bundle_hash",
              "provider_snapshot_hashes",
              "content_snapshot_hashes"
            ]
          }
        },
        "required": [
          "subject",
          "repetition",
          "candidate",
          "case",
          "passed",
          "detail",
          "run_identity"
        ]
      }
    }
  },
  "required": ["trials", "plan"]
}
