#!/bin/bash
# Pre-push hook — tracked under .githooks/ so it lives with the repo.
#
# Behavior:
#   1. Documentation routing: disposable plan-only changes skip the gate;
#      other documentation-only changes run the ExDoc warnings gate.
#   2. Otherwise: classify the affected contracts, run documentation first,
#      then invoke the same repository-owned root, Viewer, and launcher gate
#      scripts as GitHub Actions. The hook supplies changed paths; the scripts
#      own commands and environment.
#
# Override:
#   FORCE_FULL_PRE_PUSH=1 git push  → always run the full gate, even if
#   the docs-only check would have allowed a skip.
#
# Stdin contract (githooks(5)):
#   <local-ref> <local-sha> <remote-ref> <remote-sha>\n  (one per ref)
#
set -e

HOOK_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# One cleanup for every scratch path the hook creates, so a later `trap ...
# EXIT` cannot silently drop an earlier one's files. Unset names expand to
# empty, which `rm` ignores.
cleanup_pre_push() {
  rm -f "${PY_TMP:-}" "${PTC_PRE_PUSH_PATHS_FILE:-}"
  rm -rf "${GATE_RUN_DIR:-}"
  return 0
}

run_docs_gate() {
  echo ""
  echo "📚 Documentation"

  if ! "$HOOK_REPO_ROOT/scripts/ci/docs.sh"; then
    echo "❌ Documentation dependency setup or build failed. Fix the error above before pushing."
    return 1
  fi
}

# ----------------------------------------------------------------------
# Step 1: Documentation routing (unless FORCE_FULL_PRE_PUSH=1).
# ----------------------------------------------------------------------

# Read stdin once. Pre-push hooks get ref tuples on stdin; if we don't
# capture before invoking python we'd lose them. An empty stdin (e.g.
# manual invocation with no piped input) is treated as "no committed
# changes" and falls through to the dirty-worktree check.
REFS_INPUT="$(cat || true)"

if [ -z "${FORCE_FULL_PRE_PUSH:-}" ]; then
  SHORT_CIRCUIT_RESULT=0
  # Write the python helper to a temp file so its stdin stays free
  # for the pushed-ref tuples. Piping the heredoc into `python3 -`
  # would consume stdin with the script itself.
  PY_TMP="$(mktemp -t pre-push-docs-only.XXXXXX.py)"
  trap cleanup_pre_push EXIT
  cat > "$PY_TMP" <<'PYEOF'
import re
import os
import subprocess
import sys

# Exit codes returned to the bash wrapper:
#   0 → plan-only, skip the full gate.
#   2 → not docs-only, classify and run the selected gates.
#   3 → user-facing docs only, run the documentation gate.
#   1 → unexpected error; fail-safe by running the full gate.
SKIP = 0
RUN_FULL = 2
RUN_DOCS = 3

PLAN_PATTERNS = [
    re.compile(r"^Plans/.*\.md$"),
    re.compile(r"^docs/plans/.*\.md$"),
]

DOC_PATTERNS = [
    re.compile(r"^docs/.*$"),
    re.compile(r"^[^/]+\.md$"),
    re.compile(r"^ptc_runner_launcher/.*\.md$"),
    re.compile(r"^ptc_viewer/.*\.md$"),
    re.compile(r"^CHANGELOG\.md$"),
    re.compile(r"^LICENSES/.*$"),
    re.compile(r"^\.gitignore$"),
    re.compile(r"^\.githooks/README\.md$"),
]

GENERATED_DOC_PATTERNS = [
    re.compile(r"^docs/function-reference\.md$"),
    re.compile(r"^docs/java-interop\.md$"),
    re.compile(r"^docs/conformance/.*$"),
]

REPO_ROOT = os.environ["PTC_PRE_PUSH_REPO_ROOT"]
EXECUTABLE_GUIDES_PATH = os.path.join(
    REPO_ROOT, "test", "support", "executable_guides.txt"
)

def read_executable_doc_paths(path):
    paths = set()

    with open(path, encoding="utf-8") as registry:
        for raw_line in registry:
            line = raw_line.rstrip("\n")
            entry = line.strip()

            if not entry or entry.startswith("#"):
                continue

            parts = entry.split("/")
            if (
                line != entry
                or os.path.isabs(entry)
                or os.path.normpath(entry) != entry
                or "\\" in entry
                or any(part in ("", ".", "..") for part in parts)
            ):
                raise ValueError(
                    f"non-canonical executable guide path: {raw_line!r}"
                )

            paths.add(entry)

    return paths


EXECUTABLE_DOC_PATHS = read_executable_doc_paths(EXECUTABLE_GUIDES_PATH)


def matches(patterns, path):
    return any(pattern.match(path) for pattern in patterns)


def is_plan(path):
    return matches(PLAN_PATTERNS, path)


def is_documentation(path):
    return (
        matches(DOC_PATTERNS, path)
        and not matches(GENERATED_DOC_PATTERNS, path)
        and path not in EXECUTABLE_DOC_PATHS
    )


def run(args, **kwargs):
    """Run a git command, returning (stdout_bytes, returncode)."""
    proc = subprocess.run(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        **kwargs,
    )
    return proc.stdout, proc.returncode


def committed_paths(local_sha, remote_sha):
    """Return the set of file paths changed in commits being pushed.

    Uses the cumulative range diff `<base>..<local_sha>` rather than
    iterating commits with `git diff-tree`. Per-commit diff-tree
    silently emits nothing for merge commits unless `-m` is passed,
    which can let a merge whose conflict resolution changes source
    files slip past the docs-only check while every non-merge commit
    in the range only touches allow-listed paths. The cumulative
    range diff (`git diff A..B`) reflects merge-resolution changes
    naturally because it compares tree B to tree A directly.

    `--no-renames` decomposes renames into delete+add so both old
    and new paths surface. The dirty-set parser already handles
    rename-aware worktree state separately.

    Handles the all-zeros remote-sha case (first push of a new
    branch) by falling back to `origin/main..local_sha` or
    `origin/HEAD..local_sha`. If neither exists, returns None to
    force the full gate — conservative.
    """
    if set(remote_sha) == {"0"}:
        # First push of this branch.
        for base in ("origin/main", "origin/HEAD"):
            _, rc = run(["git", "rev-parse", "--verify", base])
            if rc == 0:
                rev_range = f"{base}..{local_sha}"
                break
        else:
            # No suitable upstream; force full gate.
            return None
    else:
        rev_range = f"{remote_sha}..{local_sha}"

    out, rc = run(
        ["git", "diff", "--name-only", "--no-renames", rev_range]
    )
    if rc != 0:
        # Range invalid (e.g., remote-sha not present locally) or
        # diff failed for any other reason. Be conservative.
        return None

    paths = set()
    for line in out.decode().split("\n"):
        line = line.strip()
        if line:
            paths.add(line)
    return paths


def dirty_paths():
    """Return the set of dirty paths in the worktree, rename-aware.

    Uses porcelain v1 with NUL delimiters so paths with spaces, quotes,
    and renames are parsed safely. Both old and new paths of a rename
    enter the dirty set — a rename `Plans/a.md → README.md` cannot
    evade the deny by appearing only as a "new" path.
    """
    out, rc = run(
        [
            "git",
            "status",
            "--porcelain=v1",
            "-z",
            "--untracked-files=normal",
        ]
    )
    if rc != 0:
        return None

    # Split on NUL, drop trailing empty.
    fields = out.split(b"\x00")
    if fields and fields[-1] == b"":
        fields = fields[:-1]

    paths = set()
    i = 0
    while i < len(fields):
        entry = fields[i]
        if not entry:
            i += 1
            continue
        if len(entry) < 3:
            i += 1
            continue
        status = entry[:2].decode()
        path = entry[3:].decode()
        # Porcelain v1 puts index status in column 0 and worktree
        # status in column 1. Renames/copies can appear in either
        # column ("R " staged, " R" unstaged-detected, "RR" both).
        # When either column is R/C, the next NUL-record holds the
        # *old* path.
        if status[0] in "RC" or status[1] in "RC":
            paths.add(path)  # new path
            if i + 1 < len(fields):
                paths.add(fields[i + 1].decode())  # old path
            i += 2
        else:
            paths.add(path)
            i += 1

    return paths


def main():
    refs_input = sys.stdin.read()

    committed = set()
    if refs_input.strip():
        for line in refs_input.split("\n"):
            line = line.strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) != 4:
                # Malformed input — fail safe.
                return RUN_FULL
            _local_ref, local_sha, _remote_ref, remote_sha = parts
            # Deletion: local_sha all zeros, nothing to push.
            if set(local_sha) == {"0"}:
                continue
            paths = committed_paths(local_sha, remote_sha)
            if paths is None:
                return RUN_FULL
            committed |= paths

    dirty = dirty_paths()
    if dirty is None:
        return RUN_FULL

    combined = committed | dirty

    paths_file = os.environ.get("PTC_PRE_PUSH_PATHS_FILE")
    if paths_file:
        with open(paths_file, "w", encoding="utf-8") as output:
            for path in sorted(combined):
                output.write(path)
                output.write("\n")

    # Empty combined set → nothing to push *and* clean worktree.
    if not combined or all(is_plan(path) for path in combined):
        return SKIP

    if all(is_plan(path) or is_documentation(path) for path in combined):
        return RUN_DOCS

    return RUN_FULL


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # noqa: BLE001
        # Anything unexpected → fail safe (run the full gate).
        sys.stderr.write(f"pre-push docs-only check errored: {e}\n")
        sys.exit(RUN_FULL)
PYEOF

  PTC_PRE_PUSH_PATHS_FILE="$(mktemp -t pre-push-paths.XXXXXX)"
  export PTC_PRE_PUSH_PATHS_FILE
  trap cleanup_pre_push EXIT

  set +e
  printf '%s' "$REFS_INPUT" |
    PTC_PRE_PUSH_REPO_ROOT="$HOOK_REPO_ROOT" /usr/bin/env python3 "$PY_TMP"
  SHORT_CIRCUIT_RESULT=$?
  set -e
  rm -f "$PY_TMP"

  case "$SHORT_CIRCUIT_RESULT" in
    0)
      echo "📝 Plan-only push, skipping full pre-push gate (override: FORCE_FULL_PRE_PUSH=1)"
      exit 0
      ;;
    3)
      echo "📚 Documentation-only push, running the ExDoc warnings gate..."
      run_docs_gate
      exit 0
      ;;
    2)
      : # Fall through to the full gate.
      ;;
    *)
      # Unexpected python failure — fail safe by running the full gate.
      echo "⚠️  Documentation routing failed unexpectedly (exit=$SHORT_CIRCUIT_RESULT); running full gate."
      ;;
  esac
else
  PTC_PRE_PUSH_PATHS_FILE="$(mktemp -t pre-push-force-full.XXXXXX)"
  git ls-files > "$PTC_PRE_PUSH_PATHS_FILE"
  trap cleanup_pre_push EXIT
fi

# ----------------------------------------------------------------------
# Step 2: Run the gates selected by the combined pushed and dirty paths.
# ----------------------------------------------------------------------

echo "🔍 Running pre-push checks..."

START_TIME=$(date +%s)

# Per-phase durations, replayed as one compact block at the end. The inline
# ✅ lines already carry the numbers, but a full run buries them under
# minutes of test output; the summary is what a human actually reads when
# deciding where the time went.
PHASE_LABELS=()
PHASE_TIMES=()
record_phase() {
  PHASE_LABELS+=("$1")
  PHASE_TIMES+=("$2")
}

print_phase_summary() {
  [ "${#PHASE_LABELS[@]}" -gt 0 ] || return 0
  echo ""
  echo "⏱  Phase timings:"
  local i
  for i in "${!PHASE_LABELS[@]}"; do
    printf '   %-36s %5ss\n' "${PHASE_LABELS[$i]}" "${PHASE_TIMES[$i]}"
  done
}

SCOPES_FILE="$(mktemp -t pre-push-scopes.XXXXXX)"
"$HOOK_REPO_ROOT/scripts/ci/classify-changes.sh" \
  "$PTC_PRE_PUSH_PATHS_FILE" > "$SCOPES_FILE"
# The classifier emits only fixed boolean assignments.
core=false
launcher=false
mcp_http=false
mcp_filesystem=false
java=false
viewer=false
docs=false
# shellcheck disable=SC1090
source "$SCOPES_FILE"
rm -f "$SCOPES_FILE"

# ----------------------------------------------------------------------
# Gate scheduling.
#
# Selected gates run concurrently, so a push costs the slowest gate rather
# than the sum of all of them. Measured on four cores with a warm tree, the
# six gates a core change selects went from 311 s sequentially to 201 s.
#
# Overlapping is safe because no two gates write the same artifact. The
# Dialyzer PLT, the duplication cache and the release scratch trees each have
# exactly one writer, and the one thing several gates share -- `_build/test`
# -- is guarded by Mix itself, which serialises concurrent builds of a build
# directory behind an explicit lock ("Waiting for lock on the build
# directory"). Whichever gate wins compiles; the others wait, then find a
# fresh tree.
#
# Overlapping is cheap because no gate saturates a machine: the dominant one
# is the core suite, and three quarters of it is `async: false`, so it runs at
# little more than a single core while the rest idle.
#
# It is not free, though, and the scarce resource is memory rather than CPU:
# Dialyzer, the release build and the clone detector each hold gigabytes, and
# a BEAM that starts swapping is far slower than a gate that waited its turn.
# Concurrency is therefore budgeted against RAM. Measured with three gates in
# flight on a four-core, 16 GB machine, all seven gates peaked at 6.0 GB of
# resident BEAM memory; the core suite by itself peaks at 1.3 GB.
#
# Interleaved live output would be unreadable, so each gate's output is
# captured and replayed in full the moment that gate fails. Pass and fail
# notices are printed as they happen, which is the progress a waiting push
# needs.
# ----------------------------------------------------------------------

GATE_RUN_DIR="$(mktemp -d -t pre-push-gates.XXXXXX)"
GATE_RESULTS="$GATE_RUN_DIR/results"
: > "$GATE_RESULTS"

GATE_LABELS=()
GATE_SCRIPTS=()

queue_gate() {
  GATE_LABELS+=("$1")
  GATE_SCRIPTS+=("$2")
}

# How many gates may run at once: roughly one per 4 GB of RAM, never more than
# one per core, never fewer than one. A machine too small to hold two gates
# runs them one at a time, which is exactly the old behaviour.
gate_concurrency() {
  local cpus mem_kb mem_gb jobs

  cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"

  if [ -r /proc/meminfo ]; then
    mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
  else
    # macOS and other BSDs report total bytes through sysctl.
    mem_kb="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 ))"
  fi

  mem_gb=$((mem_kb / 1024 / 1024))
  jobs=$((mem_gb / 4))

  if [ "$jobs" -gt "$cpus" ]; then
    jobs="$cpus"
  fi

  if [ "$jobs" -lt 1 ]; then
    jobs=1
  fi

  echo "$jobs"
}

# Run one gate, capturing its output. A failure is announced with the captured
# output right away, so the diagnosis is on screen while the remaining gates
# drain. Running gates are never killed: a half-assembled release or a
# partially written Dialyzer PLT would outlive the failed push.
run_gate() {
  local label="$1" script="$2"
  local started elapsed log

  log="$GATE_RUN_DIR/$(printf '%s' "$label" | tr -c 'A-Za-z0-9' '-').log"
  started=$SECONDS

  if "$script" > "$log" 2>&1; then
    elapsed=$((SECONDS - started))
    printf '%s|%s|%s|pass|%s\n' "$started" "$elapsed" "$label" "$script" \
      >> "$GATE_RESULTS"
    echo "  ✅ $label passed in ${elapsed}s"
  else
    elapsed=$((SECONDS - started))
    printf '%s|%s|%s|fail|%s\n' "$started" "$elapsed" "$label" "$script" \
      >> "$GATE_RESULTS"
    echo ""
    echo "──────── $label output ────────"
    cat "$log"
    echo "  ❌ $label failed after ${elapsed}s. Re-run: $script"
  fi
}

# A FIFO holds one byte per free slot. A gate takes a byte before it starts
# and returns it when it finishes, which blocks the loop until a slot frees
# without polling and without `wait -n` (absent from the bash 3.2 that macOS
# still ships).
run_queued_gates() {
  local jobs total i slots

  total="${#GATE_LABELS[@]}"
  [ "$total" -gt 0 ] || return 0

  jobs="$(gate_concurrency)"
  if [ "$jobs" -gt "$total" ]; then
    jobs="$total"
  fi

  echo ""
  echo "📦 Running $total gate(s), up to $jobs at a time"

  slots="$GATE_RUN_DIR/slots"
  mkfifo "$slots"
  exec 9<> "$slots"

  i=0
  while [ "$i" -lt "$jobs" ]; do
    printf '.' >&9
    i=$((i + 1))
  done

  for i in "${!GATE_LABELS[@]}"; do
    read -r -n 1 -u 9
    {
      run_gate "${GATE_LABELS[$i]}" "${GATE_SCRIPTS[$i]}"
      printf '.' >&9
    } &
  done

  wait
  exec 9>&-
}

# Record phase timings in the order gates started, and name every gate that
# failed. Their output was already replayed by the gate that ran it.
report_gates() {
  local started elapsed label status script
  local failed_labels=""

  while IFS='|' read -r started elapsed label status script; do
    [ -n "$label" ] || continue
    record_phase "$label" "$elapsed"

    if [ "$status" = fail ]; then
      failed_labels="${failed_labels}${failed_labels:+, }$label"
    fi
  done < <(sort -t'|' -k1,1n "$GATE_RESULTS")

  if [ -n "$failed_labels" ]; then
    print_phase_summary
    echo ""
    echo "❌ Pre-push gate failed: $failed_labels"
    return 1
  fi
}

# Queued longest-first, because when there are more gates than slots the last
# gate to start decides when the push ends. Warm single-gate costs measured on
# four cores: core tests 147 s, static analysis 62 s, release verification
# 46 s, launcher 43 s, Dialyzer 19 s, ExDoc 8 s, Viewer 4 s.
if [ "$core" = true ] || [ "$mcp_http" = true ] ||
   [ "$mcp_filesystem" = true ] || [ "$java" = true ]; then
  queue_gate "core tests" "$HOOK_REPO_ROOT/scripts/ci/core-tests.sh"
  queue_gate "core static analysis" "$HOOK_REPO_ROOT/scripts/ci/core-static.sh"
  queue_gate "core release verification" \
    "$HOOK_REPO_ROOT/scripts/ci/core-release.sh"
fi

if [ "$launcher" = true ]; then
  queue_gate "launcher validation" "$HOOK_REPO_ROOT/scripts/ci/launcher.sh"
fi

if [ "$core" = true ] || [ "$mcp_http" = true ] ||
   [ "$mcp_filesystem" = true ] || [ "$java" = true ]; then
  queue_gate "core Dialyzer" "$HOOK_REPO_ROOT/scripts/ci/core-dialyzer.sh"
fi

if [ "$docs" = true ] || [ "$core" = true ]; then
  queue_gate "Documentation (ExDoc)" "$HOOK_REPO_ROOT/scripts/ci/docs.sh"
fi

# Root trace and inspection contracts are consumed by the Viewer, so retain
# Viewer coverage for core changes as well as Viewer-owned changes.
if [ "$viewer" = true ] || [ "$core" = true ]; then
  queue_gate "Viewer validation" "$HOOK_REPO_ROOT/scripts/ci/viewer.sh"
fi

run_queued_gates
report_gates || exit 1

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

print_phase_summary

echo ""
echo "✅ All pre-push checks passed in ${ELAPSED}s"

# Advisory only, and never a reason to fail a push: merging happens on GitHub,
# so no local hook fires when a branch lands, and worktrees accumulate silently.
# `--no-fetch` keeps this off the network; a stale origin/main only undercounts.
if [ -x scripts/worktree.sh ]; then
  scripts/worktree.sh gc --quiet --no-fetch --no-issues 2>/dev/null || true
fi

echo ""
