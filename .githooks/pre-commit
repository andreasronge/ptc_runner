#!/bin/bash

# Pre-commit hook: runs gates per top-level Mix project.
# Projects: ".", "ptc_viewer", and "ptc_gateway". Non-existent dirs are skipped.

set -e

echo "🔍 Running pre-commit checks..."

START_TIME=$(date +%s)

PROJECTS=("." "ptc_viewer" "ptc_gateway")

ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
ALL_DELETED=$(git diff --cached --diff-filter=D --name-only)
ALL_RENAMED=$(git diff --cached --diff-filter=R --name-only)

# Filter staged paths to those owned by a given project.
# Root project ".": everything except ptc_viewer/.
project_filter() {
  local proj="$1" input="$2"
  if [ "$proj" = "." ]; then
    echo "$input" | grep -v -E '^(ptc_viewer|ptc_gateway)/' || true
  else
    echo "$input" | grep -E "^${proj}/" || true
  fi
}

# True if the project's mix.exs declares the given dep atom (e.g. credo, dialyxir).
project_has_dep() {
  local proj="$1" dep="$2"
  grep -qE "\\{:${dep}," "${proj}/mix.exs" 2>/dev/null
}

run_project_gates() {
  local proj="$1"
  local label

  if [ "$proj" = "." ]; then
    label="root (:ptc_runner)"
  else
    label="$proj/"
    [ -d "$proj" ] || return 0
  fi

  local staged deleted renamed
  staged=$(project_filter "$proj" "$ALL_STAGED")
  deleted=$(project_filter "$proj" "$ALL_DELETED")
  renamed=$(project_filter "$proj" "$ALL_RENAMED")

  local has_elixir has_config has_mix has_deleted has_renamed
  has_elixir=$(echo "$staged" | grep -E '\.(ex|exs)$' || true)
  has_config=$(echo "$staged" | grep -E '(^|/)config/.*\.exs$' || true)
  has_mix=$(echo "$staged" | grep -E '(^|/)mix\.(exs|lock)$' || true)
  has_deleted=$(echo "$deleted" | grep -E '\.(ex|exs)$' || true)
  has_renamed=$(echo "$renamed" | grep -E '\.(ex|exs)$' || true)

  if [ -z "$has_elixir" ] && [ -z "$has_config" ] && [ -z "$has_mix" ] \
     && [ -z "$has_deleted" ] && [ -z "$has_renamed" ]; then
    return 0
  fi

  echo ""
  echo "📦 Project: $label"

  pushd "$proj" > /dev/null

  if [ -n "$has_deleted" ] || [ -n "$has_renamed" ]; then
    echo "  ⚠️  Detected deleted/renamed Elixir modules — cleaning build..."
    mix clean --deps > /dev/null 2>&1 || true
    mix deps.compile > /dev/null 2>&1 || true
  fi

  # Static checks share ONE mix invocation (one BEAM boot) instead of a
  # separate `mix` process per check. `mix do a + b + c` fails fast on the
  # first non-zero task. (cwd is the project dir, so `project_has_dep "."`.)
  local checks=""
  if [ -n "$has_elixir" ]; then
    checks="format --check-formatted"
  fi
  if [ -n "$has_elixir" ] || [ -n "$has_config" ] || [ -n "$has_mix" ]; then
    checks="${checks:+$checks + }compile --warnings-as-errors"
  fi
  if [ -n "$has_elixir" ] && project_has_dep "." "credo"; then
    checks="${checks:+$checks + }credo --strict"
  fi

  if [ -n "$checks" ]; then
    echo "  ⏳ mix do $checks"
    # shellcheck disable=SC1010,SC2086  # controlled `mix do` task list
    if ! static_out=$(mix do $checks 2>&1); then
      echo "  ❌ Static checks failed in $label:"
      echo "$static_out" | tail -40
      echo "  Re-run: (cd $proj && mix do $checks)"
      popd > /dev/null
      exit 1
    fi
    echo "  ✅ Static checks passed (format / compile / credo)"
  fi

  # Scoped tests for changed test files — a single `mix test` invocation for
  # all of them.
  #
  # `--exclude slow` below is load-bearing, not decoration: this hook is the
  # only consumer of the `:slow` tag. Those ten tests (25 s) deliberately still
  # run in `precommit`, pre-push, and CI, so deleting the flag would slow this
  # fast path down rather than tighten any gate. `--exclude clojure` beside it
  # *is* redundant with `test/test_helper.exs`, and is kept only for symmetry.
  #
  # `:nightly` needs no flag here: `test/test_helper.exs` excludes it globally.
  local changed_tests
  if [ "$proj" = "." ]; then
    changed_tests=$(echo "$staged" | grep -E '^test/.*_test\.exs$' || true)
  else
    changed_tests=$(echo "$staged" | grep -E "^${proj}/test/.*_test\.exs$" \
                      | sed "s|^${proj}/||" || true)
  fi

  if [ -n "$changed_tests" ]; then
    echo "  ⏳ Running scoped tests (excluding :slow)..."
    # shellcheck disable=SC2086  # word-split the space-separated file list
    if ! test_out=$(mix test $changed_tests --exclude clojure --exclude slow 2>&1); then
      echo "  ❌ Tests failed in $label:"
      echo "$test_out" | tail -40
      popd > /dev/null
      exit 1
    fi
    echo "  ✅ Scoped tests pass"
  fi

  popd > /dev/null
}

for proj in "${PROJECTS[@]}"; do
  run_project_gates "$proj"
done

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo ""
echo "✅ All pre-commit checks passed in ${ELAPSED}s"
echo ""

if [ $ELAPSED -gt 10 ]; then
  echo "⚠️  Warning: Pre-commit took ${ELAPSED}s (target: <10s)"
fi
