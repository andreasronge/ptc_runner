{
  "version": 1,
  "workflow": {
    "components": [
      {
        "id": "incident.compiler",
        "path": "compiler.clj",
        "dependencies": [
          "agent.core",
          "kernel",
          "result",
          "workflow.event"
        ]
      },
      {
        "library": "agent.core"
      },
      {
        "library": "agent.feedback"
      },
      {
        "library": "agent.native"
      },
      {
        "library": "agent.prompt"
      },
      {
        "library": "agent.retry"
      },
      {
        "library": "kernel"
      },
      {
        "library": "llm"
      },
      {
        "library": "result"
      },
      {
        "library": "workflow.event"
      }
    ],
    "entry": "incident.compiler/run"
