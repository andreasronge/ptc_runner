{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident evidence report",
  "description": "Either a report whose material claims each carry a citation, or a structured refusal to publish one.",
  "oneOf": [
    {
      "type": "object",
      "title": "Published report",
      "additionalProperties": false,
      "required": [
        "status",
        "incident_id",
        "summary",
        "timeline",
        "observed_facts",
        "hypotheses",
        "open_questions"
      ],
      "properties": {
        "status": {"type": "string", "const": "report"},
        "incident_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "summary": {
          "type": "string",
          "description": "What happened, stated only as far as the cited facts below support.",
          "minLength": 1,
          "maxLength": 2000
        },
        "timeline": {
          "type": "array",
          "description": "Ordered observed events. Each entry cites the record it was read from.",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observed_at", "statement", "citations"],
            "properties": {
              "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
              "statement": {"type": "string", "minLength": 1, "maxLength": 600},
              "citations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "content_digest"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "content_digest": {"type": "string", "format": "sha256"}
                  }
                }
              }
            }
          }
        },
        "observed_facts": {
          "type": "array",
          "description": "Statements asserted as fact. Every one must resolve to evidence.",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "citations"],
            "properties": {
              "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
              "citations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "content_digest"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "content_digest": {"type": "string", "format": "sha256"}
                  }
                }
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "description": "Candidate explanations, kept separate from observed facts.",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "confidence", "supporting_citations"],
            "properties": {
              "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
              "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
              "supporting_citations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "content_digest"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "content_digest": {"type": "string", "format": "sha256"}
                  }
                }
              },
              "contradicting_citations": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "content_digest"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "content_digest": {"type": "string", "format": "sha256"}
                  }
                }
              }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "description": "Gaps the evidence does not close. A gap belongs here, never in observed_facts.",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "missing_evidence"],
            "properties": {
              "question": {"type": "string", "minLength": 1, "maxLength": 600},
              "missing_evidence": {"type": "string", "minLength": 1, "maxLength": 600},
              "citations": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "content_digest"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "content_digest": {"type": "string", "format": "sha256"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "title": "Withheld report",
      "description": "Abstention is a first-class outcome, not a prose apology inside a report.",
      "additionalProperties": false,
      "required": ["status", "incident_id", "reason", "open_questions"],
      "properties": {
        "status": {"type": "string", "const": "insufficient_evidence"},
        "incident_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "open_questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "missing_evidence"],
            "properties": {
              "question": {"type": "string", "minLength": 1, "maxLength": 600},
              "missing_evidence": {"type": "string", "minLength": 1, "maxLength": 600}
            }
          }
        }
      }
    }
  ]
}
