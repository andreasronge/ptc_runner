{
  "$schema": "./priv/schemas/ptc-host-config.schema.json",
  "limits": {
    "subordinate_evaluations": 24,
    "workflow_capability_calls_per_name": 24,
    "normal_event_count": 512
  },
  "credentials": {
    "openrouter_key": {
      "env": "OPENROUTER_API_KEY"
    }
  },
  "install": {
    "deepseek": {
      "source": "llm",
      "installation_revision": "repo-analyst-llm-v1",
      "model": "openrouter:deepseek/deepseek-v4-flash",
      "credential": "openrouter_key",
      "accepts_data": [
        "normal",
        "private_inspection"
      ]
    },
    "replay-llm": {
      "source": "llm_replay",
      "installation_revision": "repo-analyst-replay-v1",
      "fixtures": "repo-analyst/evaluation/replay.jsonl",
      "data_class": "private_inspection",
      "accepts_data": [
        "normal",
        "private_inspection"
      ],
      "ceilings": {
        "max_entries": 1000,
        "max_result_bytes": 250000
      }
    },
    "workspace": {
      "source": "mcp",
      "transport": {
        "type": "stdio",
        "command": "node",
        "cwd": ".",
        "args": [
          "examples/mcp/filesystem/dist/server.js",
          "--root",
          ".",
          "--include",
          "lib/**",
          "--include",
          "priv/**",
          "--include",
          "docs/**",
          "--include",
          "test/**",
          "--include",
          "examples/**",
          "--include",
          "config/**",
          "--include",
          "mix.exs",
          "--include",
          "mix.lock",
          "--include",
          "repo-analyst/*.clj",
          "--include",
          "repo-analyst/*-input.json",
          "--include",
          "repo-analyst/*.schema.json",
          "--exclude",
          "**/node_modules/**",
          "--exclude",
          "**/_build/**",
          "--exclude",
          "**/deps/**"
        ],
        "start_timeout_ms": 15000
      },
      "tools": {
        "list_directory": {
          "as": "workspace.list",
          "effect": "read"
        },
        "search_files": {
          "as": "workspace.find",
          "effect": "read"
        },
        "search_text": {
          "as": "workspace.search",
          "effect": "read",
          "error_feedback": "bounded"
        },
        "read_text_file": {
          "as": "workspace.read",
          "effect": "read",
          "error_feedback": "bounded"
        },
        "snapshot_info": {
          "as": "workspace.info",
          "effect": "read"
        }
      },
      "snapshot_identity": {
        "tool": "snapshot_info",
        "field": "snapshot_hash"
      },
      "installation_revision": "filesystem-sample-0.1.0",
      "accepts_data": [
        "normal",
        "private_inspection"
      ],
      "ceilings": {
        "timeout_ms": 15000,
        "max_catalog_tools": 32,
        "max_result_bytes": 250000
      }
    },
    "history": {
      "source": "ptc_trace_snapshot",
      "installation_revision": "repo-analyst-trace-v1",
      "directory": "tmp/traces",
      "ceilings": {
        "max_source_bytes": 8000000,
        "max_result_bytes": 250000
      }
    },
    "private-history": {
      "source": "ptc_inspection_snapshot",
      "installation_revision": "repo-analyst-inspection-v1",
      "directory": "tmp/inspection",
      "ceilings": {
        "max_files": 100,
        "max_source_bytes": 64000000,
        "max_result_bytes": 500000
      }
    }
  }
}
