{
  "$schema": "https://ptc-runner.dev/schemas/ptc-application-manifest.schema.json",
  "version": 1,
  "workflow": {
    "components": [
      {
        "id": "lab.agent",
        "path": "agent.clj",
        "dependencies": [
          "kernel"
        ]
      },
      {
        "library": "kernel"
      }
    ],
    "entry": "lab.agent/run"
  },
  "input": {
    "value": {
      "task": "compiled",
      "url": "http://127.0.0.1/unset"
    }
  },
  "contracts": {
    "input_schema": {
      "path": "input.schema.json"
    },
    "result_schema": {
      "path": "result.schema.json"
    }
  },
  "providers": {
    "mission": [
      {
        "name": "web"
      }
    ]
  },
  "missions": {
    "default": {
      "components": [
        {
          "id": "lab.web",
          "path": "web.clj"
        }
      ],
      "data": {},
      "providers": [
        "web"
      ]
    }
  }
}
