{
  "version": 1,
  "workflow": {
    "components": [
      {
        "id": "demo.agent",
        "path": "agent.clj",
        "dependencies": [
          "agent.core"
        ]
      },
      {
        "library": "agent.core"
      }
    ],
    "entry": "demo.agent/run-terminal-error"
  },
  "input": {
    "value": {
      "task": "Call (demo.files/exhaust-memory) and return its result.",
      "max_turns": 2
    }
  },
  "providers": {
    "workflow": [
      {
        "name": "deepseek"
      }
    ],
    "mission": [
      {
        "name": "workspace"
      }
    ]
  },
  "labels": {
    "name": "viewer-demo-memory",
    "model": "openrouter:deepseek/deepseek-v4-flash",
    "provider": "openrouter",
    "tags": {
      "mode": "agent"
    }
  },
  "missions": {
    "default": {
      "components": [
        {
          "id": "demo.files",
          "path": "files.clj"
        }
      ],
      "data": {
      },
      "providers": [
        "workspace"
      ]
    }
  }
}
