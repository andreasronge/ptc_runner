{
  "$schema": "./priv/schemas/ptc-application-manifest.schema.json",
  "version": 1,
  "workflow": {
    "components": [{"library": "agent.main"}],
    "entry": "agent.main/run"
  },
  "mission": {
    "components": [
      {"library": "cap"},
      {"id": "repo", "path": "repo-analyst/repo.clj", "dependencies": ["cap"]},
      {"id": "runs", "path": "repo-analyst/runs.clj", "dependencies": ["cap"]}
    ],
    "data": {}
  },
  "providers": {
    "workflow": [{"name": "deepseek"}],
    "mission": [
      {"name": "workspace"},
      {"name": "history"},
      {"name": "private-history"}
    ]
  },
  "input": {"path": "repo-analyst/improve-input.json"},
  "contracts": {
    "result_schema": {"path": "repo-analyst/candidate.schema.json"}
  },
  "limits": {
    "run_duration_ms": 120000,
    "mission_capability_calls": 64
  }
}
