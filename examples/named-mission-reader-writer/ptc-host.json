{
  "credentials": {
    "openrouter_key": {"env": "OPENROUTER_API_KEY"}
  },
  "install": {
    "agent_model": {
      "source": "llm",
      "installation_revision": "named-missions-example-v3",
      "model": "openrouter:deepseek/deepseek-v4-flash",
      "credential": "openrouter_key",
      "cache": false
    },
    "reader_workspace": {
      "source": "mcp",
      "installation_revision": "ptc-fs-mcp-reader-0.1.0",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "cwd": ".",
        "args": [
          "-y",
          "ptc-fs-mcp@0.1.0",
          "--root",
          "reader-state",
          "--include",
          "**"
        ],
        "inherit_environment": true,
        "env": {},
        "start_timeout_ms": 60000
      },
      "tools": {
        "read_text_file": {"as": "workspace.read", "effect": "read"}
      },
      "ceilings": {
        "timeout_ms": 15000,
        "max_catalog_tools": 8,
        "max_result_bytes": 262144
      }
    },
    "writer_workspace": {
      "source": "mcp",
      "installation_revision": "ptc-fs-mcp-writer-0.1.0",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "cwd": ".",
        "args": [
          "-y",
          "ptc-fs-mcp@0.1.0",
          "--root",
          "writer-state",
          "--include",
          "**"
        ],
        "inherit_environment": true,
        "env": {},
        "start_timeout_ms": 60000
      },
      "tools": {
        "write_text_file": {
          "as": "workspace.write",
          "effect": "write",
          "model_visible": true
        }
      },
      "ceilings": {
        "timeout_ms": 15000,
        "max_catalog_tools": 8,
        "max_result_bytes": 262144
      }
    }
  }
}
