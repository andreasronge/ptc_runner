{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "countries",
    "program"
  ],
  "properties": {
    "countries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ip_country",
          "fraudulent_volume",
          "total_volume"
        ],
        "properties": {
          "ip_country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "fraudulent_volume": {
            "type": "number",
            "minimum": 0
          },
          "total_volume": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "program": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "The source of the single program that produced these figures."
    }
  }
}
