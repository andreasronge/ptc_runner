{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "value", "agreed", "top_country", "problems"],
  "properties": {
    "ok": {"type": "boolean", "const": true},
    "value": {
      "type": "string",
      "enum": ["A. NL", "B. BE", "C. ES", "D. FR", "Not Applicable"]
    },
    "agreed": {"type": "boolean"},
    "top_country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "recheck", "review"],
      "properties": {
        "analysis": {"type": "string"},
        "recheck": {"type": "string"},
        "review": {"type": "string"}
      }
    },
    "problems": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
