{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "task",
    "guidelines",
    "review_task",
    "reviewer_model",
    "review_turns",
    "options",
    "analyzer_result",
    "programs"
  ],
  "properties": {
    "case_id": {"type": "string", "enum": ["wrong-metric", "off-by-one"]},
    "task": {"type": "string", "minLength": 1, "maxLength": 1000},
    "guidelines": {"type": "string", "minLength": 1, "maxLength": 2000},
    "review_task": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reviewer_model": {"type": "string", "const": "luna"},
    "review_turns": {"type": "integer", "minimum": 1, "maximum": 8},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NL", "BE", "ES", "FR"],
      "properties": {
        "NL": {"type": "string", "const": "A. NL"},
        "BE": {"type": "string", "const": "B. BE"},
        "ES": {"type": "string", "const": "C. ES"},
        "FR": {"type": "string", "const": "D. FR"}
      }
    },
    "analyzer_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivations", "candidate_answer"],
      "properties": {
        "derivations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mission", "countries"],
            "properties": {
              "mission": {"type": "string", "enum": ["analysis", "recheck"]},
              "countries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ip_country", "fraudulent_volume", "total_volume"],
                  "properties": {
                    "ip_country": {"type": "string", "minLength": 2, "maxLength": 2},
                    "fraudulent_volume": {"type": "number", "minimum": 0},
                    "total_volume": {"type": "number", "minimum": 0}
                  }
                }
              }
            }
          }
        },
        "candidate_answer": {
          "type": "string",
          "enum": ["A. NL", "B. BE", "C. ES", "D. FR", "Not Applicable"]
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "mission", "source", "execution"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1, "maximum": 128},
          "mission": {"type": "string", "enum": ["analysis", "recheck"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 64000},
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome"],
            "properties": {
              "outcome": {"type": "string", "enum": ["continued", "returned"]},
              "observation": {"type": "string", "minLength": 1, "maxLength": 2048},
              "observation-truncated?": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
