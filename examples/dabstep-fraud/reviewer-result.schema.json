{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["caught", "case_id", "problems"],
  "properties": {
    "caught": {"type": "boolean", "const": true},
    "case_id": {"type": "string", "enum": ["wrong-metric", "off-by-one"]},
    "problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
