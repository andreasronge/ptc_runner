{
  "credentials": {
    "openrouter_key": {"env": "OPENROUTER_API_KEY"}
  },
  "limits": {
    "evaluation_heap_words": 5000000
  },
  "install": {
    "deepseek": {
      "source": "llm",
      "structured_output_mode": "unsupported",
      "usage_guarantees": {"tokens": true, "cost_currency": "USD"},
      "installation_revision": "dabstep-deepseek-v2",
      "model": "openrouter:deepseek/deepseek-v4-flash",
      "credential": "openrouter_key",
      "cache": false,
      "accepts_data": ["normal", "private_inspection"],
      "params": {"max_tokens": 8192}
    },
    "luna": {
      "source": "llm",
      "structured_output_mode": "unsupported",
      "usage_guarantees": {"tokens": true, "cost_currency": "USD"},
      "installation_revision": "dabstep-luna-v2",
      "model": "openrouter:openai/gpt-5.6-luna",
      "credential": "openrouter_key",
      "cache": false,
      "accepts_data": ["normal", "private_inspection"],
      "params": {"max_tokens": 8192}
    },
    "payments_data": {
      "source": "mcp",
      "installation_revision": "ptc-fs-mcp-0.2.0-payments-csv",
      "accepts_data": ["normal", "private_inspection"],
      "transport": {
        "type": "stdio",
        "command": "npx",
        "cwd": ".",
        "args": ["-y", "ptc-fs-mcp@0.2.0", "--root", "data", "--include", "payments.csv", "--max-read-bytes", "500000", "--max-result-bytes", "1000000"],
        "inherit_environment": true,
        "env": {},
        "start_timeout_ms": 60000
      },
      "tools": {
        "read_text_file": {"as": "workspace.read", "effect": "read", "model_visible": false}
      },
      "ceilings": {
        "timeout_ms": 30000,
        "max_catalog_tools": 8,
        "max_result_bytes": 1048576
      }
    }
  }
}
