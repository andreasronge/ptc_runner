{
  "credentials": {
    "openrouter_key": {"env": "OPENROUTER_API_KEY"}
  },
  "limits": {
    "evaluation_heap_words": 5000000
  },
  "install": {
    "deepseek": {
      "source": "llm",
      "installation_revision": "dabstep-deepseek-v1",
      "model": "openrouter:deepseek/deepseek-v4-flash",
      "credential": "openrouter_key",
      "cache": false,
      "accepts_data": ["normal", "private_inspection"],
      "params": {"max_tokens": 8192}
    },
    "luna": {
      "source": "llm",
      "installation_revision": "dabstep-luna-v1",
      "model": "openrouter:openai/gpt-5.6-luna",
      "credential": "openrouter_key",
      "cache": false,
      "accepts_data": ["normal", "private_inspection"],
      "params": {"max_tokens": 8192}
    },
    "payments_data": {
      "source": "mcp",
      "installation_revision": "ptc-fs-mcp-0.1.0-payments-only",
      "accepts_data": ["normal", "private_inspection"],
      "transport": {
        "type": "stdio",
        "command": "npx",
        "cwd": ".",
        "args": ["-y", "ptc-fs-mcp@0.1.0", "--root", "data", "--include", "columns/*.txt"],
        "inherit_environment": true,
        "env": {},
        "start_timeout_ms": 60000
      },
      "tools": {
        "read_text_file": {"as": "workspace.read", "effect": "read"}
      },
      "ceilings": {
        "timeout_ms": 30000,
        "max_catalog_tools": 8,
        "max_result_bytes": 262144
      }
    }
  }
}
