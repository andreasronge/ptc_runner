{
  "$schema": "https://ptc-runner.dev/schemas/ptc-project-config.schema.json",
  "kind": "ptc-project",
  "version": 1,
  "application": {
    "path": "02-domain-api/ptc.json"
  },
  "host": {
    "path": "ptc-host.json",
    "env_file": {
      "path": ".env"
    }
