{
  "$schema": "https://ptc-runner.dev/schemas/ptc-project-config.schema.json",
  "kind": "ptc-project",
  "version": 1,
  "application": {
    "path": "debugger-agent/ptc.json"
  },
  "host": {
    "path": "ptc-host.json",
    "env_file": {"path": ".env"}
  },
  "artifacts": {
    "root": "debugger-agent/.ptc",
    "trace": true,
    "inspection": true,
    "result": true,
    "envelope": true
  },
  "viewer": {
    "port": 4125,
    "open": true,
    "repl": true,
    "private": true
  }
}
