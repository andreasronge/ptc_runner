{
  "version": 1,
  "listen": {
    "address": "127.0.0.1",
    "port": 8765,
    "path": "/mcp"
  },
  "authentication": {
    "bearer": {
      "binding": "gateway"
    }
  },
  "host": {
    "path": "ptc-host.json"
  },
  "admission": {
    "max_inflight_requests": 16,
    "max_concurrent_runs": 4,
    "max_active_provider_calls": 4,
    "max_waiting_provider_calls": 0
  },
  "artifacts": {
    "root": "artifacts",
    "trace": true,
    "events": {
      "max_file_bytes": 1048576,
      "max_retained_files": 8,
      "stderr": false
    }
  },
  "tools": [
    {
      "name": "published_briefs",
      "title": "Published briefs",
      "description": "Read one page from each of two published briefs.",
      "application": {
        "manifest": "ptc.json"
      }
    }
  ]
}
