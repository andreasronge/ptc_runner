{
  "name": "ptc-runner-filesystem-sample",
  "version": "0.1.0",
  "private": true,
  "description": "Non-production immutable read-only filesystem MCP server used by PtcRunner tutorials and integration tests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/server.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
