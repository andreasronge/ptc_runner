{
  "$schema": "https://ptc-runner.dev/schemas/ptc-application-manifest.schema.json",
  "version": 1,
  "workflow": {
    "components": [
      {"id": "query.workflow", "path": "query.clj", "dependencies": ["kernel"]},
      {"library": "kernel"}
    ],
    "entry": "query.workflow/run"
  },
  "missions": {
    "browser": {
      "components": [
        {"id": "demo.browser", "path": "browser.clj", "dependencies": ["site.recipe"]},
        {"id": "site.recipe", "path": "site.clj"}
      ],
      "providers": ["web"]
    }
  },
  "providers": {"mission": [{"name": "web"}]},
  "input": {"value": {"url": "http://127.0.0.1:3000/quotes"}},
  "limits": {
    "run_duration_ms": 90000,
    "workflow_timeout_ms": 90000,
    "evaluation_timeout_ms": 30000,
    "mission_capability_calls": 12,
    "subordinate_evaluations": 2
  },
  "labels": {"name": "adaptive-web-parser-query", "tags": {"mode": "deterministic"}}
}
