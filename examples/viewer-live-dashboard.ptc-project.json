{
  "$schema": "https://ptc-runner.dev/schemas/ptc-project-config.schema.json",
  "kind": "ptc-project",
  "version": 1,
  "application": {
    "path": "viewer-live-dashboard/ptc.json"
  },
  "host": {
    "path": "kernel-tutorial/ptc-host.json",
    "env_file": {
      "path": "kernel-tutorial/.env"
    }
  },
  "artifacts": {
    "root": "viewer-live-dashboard/.ptc",
    "trace": true,
    "inspection": false,
    "result": false,
    "envelope": true
  },
  "viewer": {
    "port": 4123,
    "open": true,
    "repl": true,
    "private": false
  }
}
