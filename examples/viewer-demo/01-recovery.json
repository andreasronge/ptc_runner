{
  "version": 1,
  "workflow": {
    "components": [
      {
        "id": "demo.agent",
        "path": "agent.clj",
        "dependencies": [
          "agent.core"
        ]
      },
      {
        "library": "agent.core"
      }
    ],
    "entry": "demo.agent/run"
  },
  "input": {
    "value": {
      "task": "First call (demo.files/parse-lines \"notes.txt\") and return its result. If an evaluation fails, recover with (demo.files/read-page \"notes.txt\" nil), concatenate item text, follow next_cursor until nil, and return the exact content as a string.",
      "max_turns": 6
    }
  },
  "providers": {
    "workflow": [
      {
        "name": "deepseek"
      }
    ],
    "mission": [
      {
        "name": "workspace"
      }
    ]
  },
  "labels": {
    "name": "viewer-demo-recovery",
    "model": "openrouter:deepseek/deepseek-v4-flash",
    "provider": "openrouter",
    "tags": {
      "mode": "agent"
    }
  },
  "missions": {
    "default": {
      "components": [
        {
          "id": "demo.files",
          "path": "files.clj"
        }
      ],
      "data": {
      }
    }
  }
}
