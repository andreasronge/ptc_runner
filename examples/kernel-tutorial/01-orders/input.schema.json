{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "customer": {"type": "string"},
          "total": {"type": "number"},
          "status": {"type": "string", "enum": ["paid", "pending"]}
        },
        "required": ["id", "customer", "total", "status"]
      }
    }
  },
  "required": ["orders"]
}
