{
  "credentials": {
    "openrouter_key": {"env": "OPENROUTER_API_KEY"}
  },
  "install": {
    "deepseek": {
      "source": "llm",
      "structured_output_mode": "unsupported",
      "usage_guarantees": {"tokens": true, "cost_currency": "USD"},
      "installation_revision": "tutorial-llm-v5",
      "model": "openrouter:deepseek/deepseek-v4-flash",
      "credential": "openrouter_key",
      "cache": false,
      "params": {"max_tokens": 4096}
    },
    "workspace": {
      "source": "mcp",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "cwd": ".",
        "args": [
          "-y",
          "ptc-fs-mcp@0.1.0",
          "--root",
          "03-file-agent/files",
          "--include",
          "**"
        ],
        "inherit_environment": true,
        "env": {},
        "start_timeout_ms": 60000
      },
      "tools": {
        "read_text_file": {
          "as": "workspace.read",
          "effect": "read"
        }
      },
      "installation_revision": "ptc-fs-mcp-0.1.0",
      "ceilings": {
        "timeout_ms": 15000,
        "max_catalog_tools": 8,
        "max_result_bytes": 262144
      }
    }
  }
}
