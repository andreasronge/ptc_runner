# PtcRunner Environment Configuration
#
# Nothing is loaded implicitly: a run reads the exact file its project document
# names, or the one passed to --env-file. The tutorial projects name a file next
# to themselves, so copy this there and fill in your values:
#
# cp .env.example examples/kernel-tutorial/.env
# chmod 600 examples/kernel-tutorial/.env
# mix ptc run examples/kernel-tutorial/04-multi-turn-agent.ptc-project.json
#
# For a manifest with no project document, name the file yourself:
#
# mix ptc run ptc.json --host-config ptc-host.json --env-file .env
#
# The test suite reads its own copy at the repository root, which is where
# PTC_TEST_MODEL below belongs. Keeping both is normal.

# =============================================================================
# API Keys (at least one required)
# =============================================================================

# OpenRouter API key (recommended - supports many models)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional direct provider keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# =============================================================================
# E2E Test Configuration
# =============================================================================

# Model for e2e tests. Optional; defaults to
# openrouter:deepseek/deepseek-v4-flash. Always a full provider-qualified
# identifier — there are no short aliases.
#
# Known-good alternatives, all cheaper than anthropic/claude-haiku-4.5
# ($1.00/$5.00 per 1M input/output tokens). Catalog rates checked 2026-08-14;
# the OpenRouter discounts behind some of them are temporary.
#   openrouter:openai/gpt-oss-120b                 $0.03/$0.17
#   openrouter:deepseek/deepseek-v4-flash          $0.14/$0.28
#   openrouter:openai/gpt-5.6-luna                 $0.10/$0.60
#   openrouter:google/gemini-3.1-flash-lite        $0.25/$1.50
# PTC_TEST_MODEL=openrouter:deepseek/deepseek-v4-flash

# Stateless MCP 2026-07-28 endpoint used by the direct and model-driven MCP
# interoperability tests. CI builds the checked-in stateless harness backed by
# the pinned official Go SDK. See "Local MCP E2E server" in AGENTS.md for exact
# local setup and test commands.
# PTC_TEST_MCP_2026_ENDPOINT=http://127.0.0.1:8000
